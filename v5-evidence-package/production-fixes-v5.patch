+        if (clip.assetId) ids.add(clip.assetId);
+      }
+    }
+    return ids;
+  }, [project]);
+
+  // Load storage details
+  const refreshStorage = async () => {
+    setLoading(true);
+    try {
+      // 1. Storage quota and usage estimation
