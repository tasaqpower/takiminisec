.original-text-hit {
  fill: transparent;
  stroke: transparent;
  cursor: pointer;
  pointer-events: all;
  transition: fill .15s,stroke .15s;
}
.original-text-hit:hover {
  fill: rgba(101,82,223,.12);
  stroke: rgba(101,82,223,.4);
  stroke-dasharray: 2 2;
}
.original-text-hit.is-ocr {
  fill: rgba(99,102,241,.08);
  stroke: rgba(99,102,241,.45);
  stroke-dasharray: 4 2;
  stroke-width: 1;
  cursor: pointer;
}
.original-text-hit.is-ocr:hover {
  fill: rgba(99,102,241,.2);
  stroke: #4f46e5;
  stroke-width: 1.5;
  stroke-dasharray: none;
}
.original-text-hit.is-selected,.original-text-hit:focus-visible {
  fill: rgba(101,82,223,.22);
  stroke: #6552df;
  stroke-width: 1.5;
  outline: none;
}
