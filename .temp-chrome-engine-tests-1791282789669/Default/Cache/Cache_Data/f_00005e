:root {
  --background: #fff;
  --foreground: #232534;
  --card: #fff;
  --card-foreground: #232534;
  --popover: #fff;
  --popover-foreground: #232534;
  --primary: #6552df;
  --primary-foreground: #fff;
  --secondary: #f5f4fa;
  --secondary-foreground: #343144;
  --muted: #f5f6f9;
  --muted-foreground: #777986;
  --accent: #eeebfc;
  --accent-foreground: #5d49d0;
  --destructive: #dc3545;
  --border: #e9e9ef;
  --input: #dedee8;
  --ring: #8472e8;
  --radius: .65rem;
  --sidebar: #fafafd;
  --sidebar-foreground: #626474;
  --sidebar-primary: #6552df;
  --sidebar-primary-foreground: #fff;
  --sidebar-accent: #eeebfc;
  --sidebar-accent-foreground: #5d49d0;
  --sidebar-border: #ebebf1;
  --sidebar-ring: #8472e8;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: "Plus Jakarta Sans",sans-serif;
  font-size: 14px;
  background: #fff;
  color: var(--foreground);
}
button,a,input,select,textarea {
  font: inherit;
}
button,a {
  touch-action: manipulation;
}
button {
  cursor: pointer;
  transition: background .18s,border-color .18s,color .18s,box-shadow .18s;
}
button:disabled {
  cursor: not-allowed;
  opacity: .45;
}
button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[contenteditable]:focus-visible {
  outline: 3px solid #aa9bee;
  outline-offset: 3px;
}
button svg {
  flex-shrink: 0;
}
a {
  text-decoration: none;
  color: inherit;
}
button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
}
h1,h2,h3,p {
  margin: 0;
}
.primary,.secondary {
  min-height: 44px;
  border-radius: 9px;
  font-weight: 600;
  padding: 0 18px;
}
.primary {
  background: var(--primary);
  color: white;
  border: 1px solid var(--primary);
  box-shadow: 0 3px 5px #5946c216;
}
.primary:hover {
  background: #5742ce;
}
.secondary {
  background: white;
  border: 1px solid #e2e2ea;
  color: #4c4d5c;
}
.secondary:hover {
  background: #f7f6fc;
}
.brand {
  padding: 32px 24px 25px;
}
.brand a {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 33px;
  letter-spacing: -1.5px;
  font-weight: 700;
  color: #282537;
}
.brand-symbol {
  background: var(--primary);
  color: #fff;
  display: grid;
  place-items: center;
  width: 35px;
  height: 39px;
  border-radius: 10px;
  transform: rotate(-7deg);
}
.brand-symbol svg {
  transform: rotate(7deg);
}
.brand-dot {
  color: var(--primary);
}
.sidebar-body {
  padding: 0 17px;
  gap: 0;
}
.sidebar-upload {
  width: 100%;
  margin: 3px 0 33px;
  height: 45px;
}
.nav-caption {
  font-size: 10px;
  letter-spacing: 1.5px;
  font-weight: 700;
  padding: 0 12px;
  margin-bottom: 12px;
  color: #898996;
}
.nav-item {
  font-size: 13px !important;
  height: 43px !important;
  border-radius: 7px !important;
  padding: 0 12px !important;
  gap: 12px !important;
  font-weight: 500;
}
.nav-item svg {
  width: 17px !important;
  height: 17px !important;
  stroke-width: 1.7;
}
.nav-item[data-active=true] {
  font-weight: 600;
  color: #624ed6;
}
.tools-caption {
  margin-top: 29px;
}
.nav-new {
  margin-left: auto;
  background: #efebfd;
  color: #6c54d9;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 9px;
}
.local-card {
  margin: 38px 6px 24px;
  border: 1px solid #e7e4f1;
  background: linear-gradient(140deg,#f4f1fe,#fafafd);
  border-radius: 10px;
  padding: 17px 15px;
}
.local-icon {
  color: #7662da;
  display: block;
  margin-bottom: 11px;
}
.local-card strong {
  font-size: 12px;
  font-weight: 600;
  color: #424052;
}
.local-card p {
  font-size: 11px;
  line-height: 1.85;
  color: #767184;
  margin: 7px 0 13px;
}
.local-card>span:last-child {
  font-size: 10px;
  color: #80778c;
  display: flex;
  align-items: center;
  gap: 5px;
}
.sidebar-footer {
  padding: 8px 20px 0;
}
.sidebar-footer>button {
  color: #777784;
  font-size: 11px;
  justify-content: flex-start;
  min-height: 42px;
}
.sidebar-footer>button svg:last-child {
  margin-left: auto;
}
.profile {
  margin: 8px -20px 0;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 20px 18px;
  border-top: 1px solid var(--border);
}
.avatar {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  background: #ebe8f7;
  color: #746393;
  border: 3px solid white;
  border-radius: 50%;
  font-size: 11px;
  font-weight: 700;
}
.profile strong {
  display: block;
  font-size: 10px;
  color: #545364;
}
.profile small {
  display: block;
  font-size: 8px;
  color: #95929f;
  margin-top: 4px;
}
.main-shell {
  flex: 1;
  min-width: 0;
}
.topbar {
  height: 74px;
  padding: 0 40px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 22px;
}
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 13px;
  font-size: 12px;
  color: #92929e;
}
.breadcrumb strong {
  font-weight: 500;
  color: #4e4d60;
}
.private-label {
  margin-left: auto;
  display: flex;
  align-items: center;
