+      hasAudio = true;
+    }
+
+    if (isWebm) {
+      onProgress({
+        percent: 97,
+        currentFrame: totalFrames,
+        totalFrames,
+        etaSeconds: 1,
+        statusText: 'WebM container mux ediliyor (VP8 + Opus)...',
+      });
+
+      let totalYuvLen = 0;
+      for (const p of webmYuvParts) totalYuvLen += p.length;
+      const mergedYuv = new Uint8Array(totalYuvLen);
+      let yuvOffset = 0;
+      for (const p of webmYuvParts) {
+        mergedYuv.set(p, yuvOffset);
+        yuvOffset += p.length;
+      }
+      core.FS.writeFile('input.yuv', mergedYuv);
+
+      const muxArgs = hasAudio
+        ? [
+            '-f', 'rawvideo',
+            '-pix_fmt', 'yuv420p',
+            '-s', `${width}x${height}`,
+            '-framerate', String(fps),
+            '-i', 'input.yuv',
+            '-i', 'audio.wav',
+            '-c:v', 'libvpx',
+            '-b:v', '3000k',
+            '-deadline', 'realtime',
+            '-cpu-used', '8',
+            '-strict', '-2',
+            '-c:a', 'opus',
+            '-b:a', '128k',
+            '-shortest',
+            '-f', 'webm',
+            'final_export.webm',
